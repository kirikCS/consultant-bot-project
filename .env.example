# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=changeme

# Internal service URLs (used inside docker-compose network)
LLM_URL=http://llm:8080
EMBEDDER_URL=http://embedder:8081

# Retrieval knobs
TOP_K_DENSE=20
TOP_K_SPARSE=20
RRF_K=60
RERANK_INPUT=10
TOP_N_FINAL=3

# LLM generation
ANSWER_TEMPERATURE=0.0
ANSWER_MAX_TOKENS=2048
RERANK_TEMPERATURE=0.0
RERANK_MAX_TOKENS=32

# Memory (rolling-window context)
SHORT_TERM_K=4               # older turns surfaced by relevance into the prompt
SHORT_TERM_WINDOW=50         # legacy cap (kept for downstream compatibility)
MEMORY_PINNED_RECENT=6       # last N turns always pinned regardless of relevance
MEMORY_MAX_CHARS=3500        # char budget; older 70% gets deterministic-summarized

# Agent loop
AGENT_MAX_ITERS=3            # max tool-call iterations per user turn
