# Токен Telegram-бота из @BotFather
TELEGRAM_BOT_TOKEN=changeme

# Внутренние URL сервисов (используются внутри docker-compose сети)
LLM_URL=http://llm:8080
EMBEDDER_URL=http://embedder:8081

# Параметры retrieval
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_TFIDF=20
RRF_K=60
RERANK_INPUT=10
TOP_N_FINAL=3

# Генерация LLM
ANSWER_TEMPERATURE=0.0
ANSWER_MAX_TOKENS=2048
RERANK_TEMPERATURE=0.0
RERANK_MAX_TOKENS=32

# Кратковременная память (скользящее окно)
