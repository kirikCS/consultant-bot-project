# Токен Telegram-бота из @BotFather
TELEGRAM_BOT_TOKEN=changeme

# LLM (DeepSeek API)
LLM_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat

# Локальный embedder (nomic-embed-text через llama.cpp в docker)
EMBEDDER_URL=http://embedder:8081

# Параметры retrieval
TOP_K_DENSE=20
TOP_K_SPARSE=20
TOP_K_TFIDF=20
RRF_K=60
RERANK_INPUT=10
TOP_N_FINAL=3

# Генерация LLM
ANSWER_TEMPERATURE=0.0
ANSWER_MAX_TOKENS=1500
RERANK_TEMPERATURE=0.0
RERANK_MAX_TOKENS=32

# Кратковременная память (скользящее окно)
SHORT_TERM_K=4
SHORT_TERM_WINDOW=50
MEMORY_PINNED_RECENT=6
MEMORY_MAX_CHARS=6000

# Цикл агента
AGENT_MAX_ITERS=3
